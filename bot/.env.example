# ===========================================
# SmartTrade Starter Kit - Environment Configuration
# ===========================================
# Скопируйте этот файл в .env и заполните значениями
# cp .env.example .env

# -------------------------------------------
# Сеть и RPC
# -------------------------------------------
# URL RPC ноды (devnet/mainnet)
# Devnet: https://api.devnet.solana.com
# Mainnet: https://api.mainnet-beta.solana.com
# Рекомендуется использовать приватные RPC (Helius, QuickNode, Alchemy)
RPC_URL=https://api.devnet.solana.com

# Кластер для Anchor
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com

# Сеть (devnet/mainnet)
NETWORK=devnet

# -------------------------------------------
# Кошелёк
# -------------------------------------------
# Путь к файлу кошелька (для Anchor)
ANCHOR_WALLET=/workspace/bot/wallets/devnet-wallet.json

# Приватный ключ в base58 (альтернатива файлу кошелька)
# Получить из файла: solana-keygen export wallets/devnet-wallet.json --outfile - --force | base58 -d | xxd -p -c 256
# Или сгенерировать новый: npm run generate-wallet
WALLET_SECRET_KEY=REPLACE_WITH_YOUR_BASE58_PRIVATE_KEY

# -------------------------------------------
# Смарт-контракт
# -------------------------------------------
# PROGRAM_ID вашего контракта (обновляется после деплоя)
PROGRAM_ID=REPLACE_WITH_DEPLOYED_PROGRAM_ID

# -------------------------------------------
# Конфигурация пулов
# -------------------------------------------
# Путь к конфигу пулов
PAIRS_CONFIG=./config/pairs.devnet.json

# Минимальная ликвидность для рассмотрения (в долларах)
MIN_LIQUIDITY_USD=10000

# Максимальный размер позиции (в SOL)
MAX_POSITION_SIZE_SOL=1.0

# -------------------------------------------
# Торговые параметры
# -------------------------------------------
# Максимальное проскальзывание (в basis points, 100 = 1%)
MAX_SLIPPAGE_BPS=30

# Минимальная прибыль для сделки (в basis points)
MIN_PROFIT_BPS=50

# Размер комиссии DEX (в basis points)
# Raydium: 25 bps (0.25%)
# Orca Whirlpool: зависит от пула (обычно 30-64 bps)
DEX_FEE_BPS_RAYDIUM=25
DEX_FEE_BPS_ORCA=30

# -------------------------------------------
# CircuitBreaker (Защита от убытков)
# -------------------------------------------
# Максимальный дневной убыток (в SOL)
CIRCUIT_BREAKER_MAX_LOSS_SOL=1.0

# Максимальное количество ошибок перед остановкой
CIRCUIT_BREAKER_MAX_ERRORS=5

# Максимальное количество последовательных убыточных сделок
CIRCUIT_BREAKER_MAX_CONSECUTIVE_LOSSES=3

# Время блокировки после срабатывания (в минутах)
CIRCUIT_BREAKER_COOLDOWN_MINUTES=15

# -------------------------------------------
# Rate Limiting
# -------------------------------------------
# Максимум RPC запросов в секунду
RATE_LIMIT_RPC_PER_SECOND=100

# Максимум запросов к DEX API в секунду
RATE_LIMIT_DEX_API_PER_SECOND=10

# Максимум транзакций в секунду
RATE_LIMIT_TRANSACTIONS_PER_SECOND=5

# -------------------------------------------
# Уведомления (Telegram)
# -------------------------------------------
# Токен бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# ID чата для уведомлений (получить у @userinfobot или из группы)
TELEGRAM_CHAT_ID=REPLACE_WITH_TELEGRAM_CHAT_ID

# Уровень логирования для Telegram (info/warning/error)
TELEGRAM_LOG_LEVEL=info

# -------------------------------------------
# Уведомления (Discord)
# -------------------------------------------
# Webhook URL для уведомлений (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=REPLACE_WITH_DISCORD_WEBHOOK_URL

# Уровень логирования для Discord
DISCORD_LOG_LEVEL=warning

# -------------------------------------------
# Мониторинг (Prometheus)
# -------------------------------------------
# Порт для метрик Prometheus
PROMETHEUS_PORT=9300

# Включить сбор метрик
ENABLE_METRICS=true

# -------------------------------------------
# Логирование
# -------------------------------------------
# Уровень логирования (debug/info/warn/error)
LOG_LEVEL=info

# Формат логов (json/text)
LOG_FORMAT=json

# Путь к файлу логов
LOG_FILE=/workspace/bot/logs/bot.log

# Максимальный размер файла логов (в MB)
LOG_MAX_SIZE_MB=100

# Количество файлов логов для ротации
LOG_MAX_FILES=5

# -------------------------------------------
# Безопасность
# -------------------------------------------
# Включить валидацию входных данных
ENABLE_INPUT_VALIDATION=true

# Включить санитизацию чувствительных данных в логах
SANITIZE_SENSITIVE_DATA=true

# Whitelist адресов для CPI вызовов (через запятую)
# Оставьте пустым для использования встроенного whitelist
CPI_WHITELIST_ADDRESSES=

# -------------------------------------------
# Production настройки
# -------------------------------------------
# Режим работы (development/production)
NODE_ENV=development

# Включить подробное логирование ошибок
DEBUG_ERRORS=false

# Интервал сканирования рынка (в миллисекундах)
SCAN_INTERVAL_MS=5000

# Таймаут транзакции (в секундах)
TRANSACTION_TIMEOUT_SECONDS=30

# Количество повторных попыток при ошибке
MAX_RETRY_ATTEMPTS=3

# Задержка между попытками (в миллисекундах)
RETRY_DELAY_MS=1000

# -------------------------------------------
# Бэктестинг
# -------------------------------------------
# Период бэктестинга по умолчанию (в днях)
BACKTEST_DEFAULT_DAYS=7

# Сохранять результаты бэктестинга
SAVE_BACKTEST_RESULTS=true

# Путь для сохранения результатов
BACKTEST_OUTPUT_DIR=/workspace/bot/backtest-results
